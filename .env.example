# Public Turnstile widget key. Required in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only values. Never prefix these with NEXT_PUBLIC_.
TURNSTILE_SECRET_KEY=
PORTFOLIO_CONTACT_EMAIL=

# Optional comma-separated override. Production defaults to these two hosts.
TURNSTILE_ALLOWED_HOSTNAMES=chand1012.dev,www.chand1012.dev
